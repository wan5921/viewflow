+    @mock.patch.object(Activation, "create")
+    def test_if_cond_true_branch(self, mock_create):
+        mock_true_node = mock.MagicMock()
+        mock_false_node = mock.MagicMock()
+        mock_create.return_value = mock.MagicMock()
+
+        mock_flow_task = mock.MagicMock()
+        mock_flow_task._condition = mock.MagicMock(return_value=True)
+        mock_flow_task._on_true = mock_true_node
+        mock_flow_task._on_true_data = None
+        mock_flow_task._on_true_seed = None
+        mock_flow_task._on_false = mock_false_node
+        mock_flow_task._on_false_data = None
+        mock_flow_task._on_false_seed = None
+
+        mock_process = mock.MagicMock()
