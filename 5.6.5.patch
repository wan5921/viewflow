+        task.process = mock.MagicMock()
+        task.process.coerced = mock_process
+        task.flow_task = mock_flow_task
+        task.data = {}
+
+        activation = IfActivation(task)
+
+        activation.activate()
+        self.assertTrue(activation._condition_result)
+
+        task.status = STATUS.DONE
+        list(activation.create_next())
+
+        mock_true_node._create.assert_called_once()
